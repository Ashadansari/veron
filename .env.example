# Server-only: PostgreSQL runtime connection. Use TLS and a least-privilege role in production.
DATABASE_URL=
# Test-only: a separate disposable PostgreSQL database; never point this at production.
TEST_DATABASE_URL=
# Server-only: at least 32 random characters; store in the deployment secret manager.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Server-only: canonical auth origin. Production must use HTTPS.
BETTER_AUTH_URL=http://127.0.0.1:3000
# Optional server-only Google OAuth credentials. Manual email/password auth works without these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public (not a credential): canonical storefront origin. Production must use HTTPS.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# Optional comma-separated actual reverse proxy IPs/CIDRs; leave unset for a single sanitized X-Forwarded-For value.
TRUSTED_PROXY_CIDRS=
# Local seed only; not used to create the production admin.
SEED_ADMIN_EMAIL=
# Server-only optional Khalti merchant secret; required only to enable online payment.
KHALTI_SECRET_KEY=
# Server-only: sandbox or production. Keep sandbox until E2E validation is complete.
KHALTI_ENVIRONMENT=sandbox
